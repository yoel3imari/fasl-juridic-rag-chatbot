# LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# Vector store
QDRANT_URL=http://localhost:6333
# Local file path or :memory: — same code path as remote URL, no server needed
QDRANT_LOCAL_PATH=
EMBEDDING_DIM=1024

# Embeddings (CrispEmbed bge-m3 via HTTP)
CRISPEMBED_URL=http://localhost:8080

# Database
DATABASE_URL=sqlite+aiosqlite:///./matters.db

# Privacy
MATTER_PRIVACY_MODE=strict

# Library
LIBRARY_VERSION=1.0.0
