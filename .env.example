# LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=granite-embedding-107m
# OpenRouter (cloud): LLM_PROVIDER=openrouter, LLM_MODEL=<vendor/model>
# e.g. LLM_MODEL=openai/gpt-4o-mini — builds "openrouter:openai/gpt-4o-mini".
# Env wins over keys stored in the database (llm_provider_credentials in matters.db):
# a non-empty value here shadows the stored key, so a stale or dead env key shadows a
# valid stored one. Leave a var empty to fall through to the database.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Direct provider keys, same env-wins precedence as above
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Vector store
QDRANT_URL=http://localhost:6333
# Local file path or :memory: — same code path as remote URL, no server needed
QDRANT_LOCAL_PATH=
EMBEDDING_DIM=384

# Embeddings (CrispEmbed granite-embedding-107m via HTTP; bge-m3 is the gate fallback)
CRISPEMBED_URL=http://localhost:8080

# Database
DATABASE_URL=sqlite+aiosqlite:///./matters.db

# Privacy
MATTER_PRIVACY_MODE=strict

# Library
LIBRARY_VERSION=1.0.0

# Bulk library pipeline (law-corpus ingest)
LIBRARY_SOURCE_DIR=/home/xozev/Documents/legal/shortlist
LIBRARY_ARTIFACT_DIR=./data/library-artifacts
LIBRARY_EMBED_BATCH_TEXTS=32
LIBRARY_EMBED_TIMEOUT_SECONDS=300
LIBRARY_INDEX_BATCH_POINTS=128
# RAM-safe default on a 2-core host; =2 is a documented opt-in
LIBRARY_EXTRACT_WORKERS=1
LIBRARY_OCR_MODE=auto
LIBRARY_OCR_DPI=300
LIBRARY_OCR_MIN_CHARS=20
LIBRARY_OCR_TIMEOUT_SECONDS=120
