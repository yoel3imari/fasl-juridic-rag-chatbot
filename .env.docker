# Docker-stack env (task 11). Service-to-service URLs use compose names;
# the browser still reaches the API at localhost:8000 (see compose file).
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
# OpenRouter (cloud): set LLM_PROVIDER=openrouter, LLM_MODEL=<vendor/model>
# e.g. openai/gpt-4o-mini, and provide the key below.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=bge-m3
QDRANT_URL=http://qdrant:6333
CRISPEMBED_URL=http://crispembed:8080
DATABASE_URL=sqlite+aiosqlite:///./data/matters.db
MATTER_PRIVACY_MODE=strict
LIBRARY_VERSION=1.0.0
FASL_STORAGE_DIR=/app/data/storage
QDRANT_EVIDENCE_COLLECTION=matter_evidence
QDRANT_AUTHORITY_COLLECTION=legal_authorities
